# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
# Example: postgresql://postgres:password@localhost:5432/business_cards?schema=public
# Or a cloud database URL like Supabase, Neon, Railway:
DATABASE_URL="postgresql://postgres:password@localhost:5432/business_cards?schema=public"

# Admin Authentication
JWT_SECRET=business_card_scanner_jwt_secret_dev_key_very_secure_987654321
JWT_EXPIRES_IN=1d
ADMIN_DEFAULT_EMAIL=admin@businesscards.com
ADMIN_DEFAULT_PASSWORD=Admin@12345

# Cloudinary Integration (Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud Vision & Sheets Integration
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

