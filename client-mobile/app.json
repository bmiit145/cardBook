{
  "expo": {
    "name": "CardBook - Business Card Scanner",
    "slug": "cardbook-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFD300",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardbook.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "CardBook needs access to your camera to scan business cards.",
        "NSPhotoLibraryUsageDescription": "CardBook needs access to your photos to import business card images.",
        "NSContactsUsageDescription": "CardBook needs access to contacts to save scanned business cards to your device address book."
      }
    },
    "android": {
      "package": "com.cardbook.ai",
      "adaptiveIcon": {
        "backgroundColor": "#FFD300",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
